{
  "name": "planner-ccmp-support",
  "version": "0.1.0",
  "private": true,
  "description": "Planner CCMP Support - Microsoft 365 Planner の CSV からアローダイアグラム(PERT図)を作成し、CCPM向けの合流バッファ候補・クリティカルチェーンを算出するオフラインツール",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/inject-csp-hash.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
